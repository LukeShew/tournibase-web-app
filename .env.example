# Hosted staging and production must both use:
# https://khwaafsdtgiymucppkmo.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Local example for the pending pricing model; these are NOT the deployed values.
# Keep hosted production checkout false until its launch gate passes. Activate
# matching tiers on both sites only after Express/provider and refund verification:
# $1 per paid pass through $10; above $10, $1 + 4% of the full ticket price.
TOURNIBASE_APP_ENVIRONMENT=test
TOURNIBASE_PAID_CHECKOUT_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_your_key
TOURNIBASE_STRIPE_PLATFORM_ACCOUNT_ID=acct_your_platform_account
STRIPE_CONNECTED_PAYMENTS_WEBHOOK_SECRET=whsec_your_connected_payments_endpoint_secret
STRIPE_CONNECT_ACCOUNT_WEBHOOK_SECRET=whsec_your_account_status_endpoint_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
# Dedicated card-only parent configuration from the platform's matching Stripe mode.
# Checkout fails closed if it is missing or its resolved methods are not card-only.
STRIPE_CHECKOUT_PAYMENT_METHOD_CONFIGURATION=pmc_your_card_only_configuration
TOURNIBASE_PLATFORM_FEE_POLICY=per_ticket_v2
TOURNIBASE_PLATFORM_FEE_BPS=400
TOURNIBASE_PLATFORM_FEE_FIXED_CENTS=100
# After coordinated activation, staging uses these fees with Sandbox money.
TOURNIBASE_SANDBOX_FEE_QA_ENABLED=false

# Keep disabled locally unless you intentionally want to send real email.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=re_your_server_only_key
EMAIL_FROM=TourniBase <passes@tournibase.com>
SUPPORT_EMAIL_TO=lsautomates@gmail.com
# Required when the test environment sends email through Resend. Never set in live.
TOURNIBASE_EMAIL_OVERRIDE_TO=lsautomates@gmail.com
